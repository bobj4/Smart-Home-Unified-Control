# Copy to deploy/.env and adjust. Every setting is optional.

# Browser origins allowed to call the API, comma-separated. Leave empty when
# the web app and API are served from the same address (the normal setup).
CORS_ORIGINS=

# Session lifetime in seconds: idle timeout and absolute limit.
IDLE_TIMEOUT_SECONDS=1800
TOTAL_TIMEOUT_SECONDS=43200

# Enabled login methods. Only "password" (with TOTP) exists so far.
LOGIN_METHODS=password

# Encrypts saved logins (Rheem, TVs, Frigate) and the HTTPS key. Use the
# same key as before, or saved logins must be entered again. Make a new one
# with: deploy/linux/smarthome make-key (Linux), or from backend/ with
# python -m scripts.make_secrets_key. The Linux installer fills it in.
# Keep it private, and backed up somewhere other than this computer.
SECRETS_KEY=

# Seconds between background reads of TVs and water heaters (0 = off).
REFRESH_SECONDS=30

# Database backups inside the data volume: every BACKUP_HOURS (0 = never),
# the newest BACKUP_KEEP kept.
BACKUP_HOURS=24
BACKUP_KEEP=14

# The host address port 8000 is published on. Empty = every address (phones
# on the home network). Behind a reverse proxy on this server use 127.0.0.1:
# Docker publishes ports ahead of the firewall, so a firewall rule does not
# do this. "smarthome install --access proxy" sets it.
BIND_ADDRESS=

# Reverse proxy only: the addresses whose X-Forwarded-For is believed
# (comma-separated). In Docker the proxy's requests arrive from the Docker
# network's gateway, not 127.0.0.1. "smarthome install --access proxy" (and
# start, update) set it to that gateway. Without it every visitor looks like
# the proxy: one shared login-failure count, wrong addresses in the audit log.
# FORWARDED_ALLOW_IPS=127.0.0.1,172.18.0.1

# The first account's password, used only when the database has no accounts
# yet (username "admin"). Empty = "admin". The Linux installer sets a random
# one on a new install and shows it once; change it after logging in.
FIRST_ADMIN_PASSWORD=
